# This is the standalone Palmimo Portal repository, so it carries its own
# complete ignore list.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.uv/

# Testing, linting and type checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
tmp/

# Jupyter Notebook
.ipynb_checkpoints/

# IDEs and editors
.vscode/
.idea/
.project
.pydevproject
.settings/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment
.env
.env.local
.env.*.local

# Palmimo Portal frontend (frontend/). Installed packages only -- source,
# and the two remaining committed build-artifact sets (openapi.json,
# src/api/generated/), are not ignored.
node_modules/
# TanStack Router's file-based route tree, regenerated by the router Vite
# plugin from src/routes/ on every `dev` and `build` -- not hand-authored,
# and not one of the committed artifact sets either.
frontend/src/routeTree.gen.ts
# The frontend's build output (`make build`/`make fetch-static` ->
# palmimo_portal/static/). No longer committed: it ships as a GitHub
# Release asset the device's Updater downloads instead of building on the
# device -- see doc/releasing.md and Makefile's `fetch-static` target.
palmimo_portal/static/
